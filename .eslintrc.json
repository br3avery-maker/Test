{
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "Web3Modal": "readonly",
    "WalletConnectProvider": "readonly",
    "gapi": "readonly",
    "google": "readonly",
    "playgama": "readonly"
  },
  "overrides": [
    {
      "files": ["**/*.test.js", "**/*.spec.js"],
      "env": {
        "jest": true
      },
      "globals": {
        "global": "readonly"
      }
    }
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "prefer-const": "error"
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/"
  ]
}